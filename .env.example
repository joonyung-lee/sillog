# Spring Boot
SPRING_PROFILES_ACTIVE=prod

# Content Sync Webhook API Key (generate with: openssl rand -hex 32)
SILLOG_WEBHOOK_API_KEY=your-webhook-api-key-here

# Host path to content directory
CONTENT_PATH=/var/data/sillog-content

# Caddyfile to use (Caddyfile or Caddyfile.local)
CADDYFILE=Caddyfile

# Cloudflare Tunnel Token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
