# Spring profile (local / prod)
SPRING_PROFILES_ACTIVE=prod

# Webhook API key for content sync (generate with: openssl rand -hex 32)
SILLOG_WEBHOOK_API_KEY=

# Path to content directory on host filesystem
CONTENT_PATH=/var/data/sillog-content

# Caddyfile to use (Caddyfile for production, Caddyfile.local for local dev)
CADDYFILE=Caddyfile
